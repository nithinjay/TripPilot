{
    "name": "trippilot-api",
    "version": "1.0.0",
    "description": "TripPilot is a AI-powered travel advisor built with Google ADK, Gemini, Node.js, and React, demonstrating AI agents, tool calling, orchestration, and backend-independent architecture.",
    "main": "dist/server.js",
    "scripts": {
      "build": "tsc",
      "start": "node dist/server.js",
      "dev": "ts-node-dev --respawn --transpile-only src/server.ts"
    },
    "dependencies": {
      "@google/genai": "^0.1.1",
      "cors": "^2.8.5",
      "dotenv": "^16.4.5",
      "express": "^4.19.2"
    },
    "devDependencies": {
      "@types/cors": "^2.8.17",
      "@types/express": "^4.17.21",
      "@types/node": "^20.12.7",
      "ts-node-dev": "^2.0.0",
      "typescript": "^5.4.5"
    }
  }